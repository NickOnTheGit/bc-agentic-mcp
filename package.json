{
  "name": "api-drift-detector-poc",
  "version": "1.0.0",
  "description": "Config-driven OpenAPI contract monitoring engine (POC)",
  "type": "module",
  "scripts": {
    "validate-config": "node scripts/validate-config.js",
    "fetch-spec": "node scripts/fetch-spec.js",
    "normalize-spec": "node scripts/normalize-spec.js",
    "run-diff": "node scripts/run-diff.js",
    "filter-diff": "node scripts/filter-diff.js",
    "pipeline": "npm run validate-config && npm run fetch-spec && npm run normalize-spec && npm run run-diff && npm run filter-diff"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "openapi",
    "api",
    "contract",
    "drift",
    "monitoring"
  ],
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.12.0",
    "js-yaml": "^4.1.0",
    "openapi-diff": "^0.24.1"
  },
  "devDependencies": {
    "@redocly/cli": "^1.25.0"
  }
}
